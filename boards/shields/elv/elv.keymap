#include "behaviors.dtsi"
#include "dt-bindings/zmk/keys.h"
#include "dt-bindings/zmk/bt.h"
#include "dt-bindings/zmk/outputs.h"

#define MAC_QWERTY 0
#define WIN_QWERTY 1
#define MAC_COLEMAK 2
#define WIN_COLEMAK 3
#define LOWER 4
#define RAISE 5
#define ADJUST 6

/ {
    keymap {
        compatible = "zmk,keymap";

        mac_qwerty_layer {
            bindings = <
                &kp ESC   &kp Q     &kp W    &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
                &kp TAB   &kp A     &kp S    &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
                &kp LSHFT &kp Z     &kp X    &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                &kp LCTRL &kp LGUI  &kp LALT &mo ADJUST &mo LOWER &kp SPACE &kp SPACE &mo RAISE &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT
            >;
        };

        win_qwerty_layer {
            bindings = <
                &kp ESC   &kp Q     &kp W    &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
                &kp TAB   &kp A     &kp S    &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
                &kp LSHFT &kp Z     &kp X    &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                &kp LGUI  &kp LCTRL &kp LALT &mo ADJUST &mo LOWER &kp SPACE &kp SPACE &mo RAISE &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT
            >;
        };

        mac_colemak_layer {
            bindings = <
                &kp ESC   &kp Q     &kp W    &kp F     &kp P     &kp B     &kp J     &kp L     &kp U     &kp Y     &kp SEMI  &kp BSPC
                &kp TAB   &kp A     &kp R    &kp S     &kp T     &kp G     &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT
                &kp LSHFT &kp Z     &kp X    &kp C     &kp D     &kp V     &kp K     &kp H     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                &kp LCTRL &kp LGUI  &kp LALT &mo ADJUST &mo LOWER &kp SPACE &kp SPACE &mo RAISE &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT
            >;
        };

        win_colemak_layer {
            bindings = <
                &kp ESC   &kp Q     &kp W    &kp F     &kp P     &kp B     &kp J     &kp L     &kp U     &kp Y     &kp SEMI  &kp BSPC
                &kp TAB   &kp A     &kp R    &kp S     &kp T     &kp G     &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT
                &kp LSHFT &kp Z     &kp X    &kp C     &kp D     &kp V     &kp K     &kp H     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                &kp LGUI  &kp LCTRL &kp LALT &mo ADJUST &mo LOWER &kp SPACE &kp SPACE &mo RAISE &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT
            >;
        };

        lower_layer {
            bindings = <
                &kp GRAVE &kp N1    &kp N2   &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
                &trans    &kp EXCL  &kp AT   &kp HASH  &kp DLLR  &kp PRCNT &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp PIPE
                &trans    &kp EQUAL &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC  &kp LBKT  &kp RBKT  &kp SEMI  &kp COLON &kp BSLH  &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &mo ADJUST &kp HOME  &kp PG_DN &kp PG_UP &kp END
            >;
        };

        raise_layer {
            bindings = <
                &kp F1    &kp F2    &kp F3   &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
                &trans    &kp INS   &kp PSCRN &kp K_APP &trans    &trans    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
                &trans    &kp NUM   &kp CAPS  &kp SLCK  &trans    &trans    &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans    &trans
                &trans    &trans    &trans    &trans    &mo ADJUST &trans    &trans    &trans    &kp PREV  &kp PP    &kp NEXT  &kp C_VOL_UP
            >;
        };

        adjust_layer {
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans    &trans    &trans    &trans    &trans    &trans
                &to MAC_QWERTY &to WIN_QWERTY &to MAC_COLEMAK &to WIN_COLEMAK &trans &trans &trans    &trans    &trans    &trans    &trans    &trans
                &reset     &bootloader  &out OUT_USB &out OUT_BLE &trans      &trans       &trans    &trans    &trans    &trans    &trans    &trans
                &trans     &trans       &trans       &trans       &trans      &trans       &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };
    };
};