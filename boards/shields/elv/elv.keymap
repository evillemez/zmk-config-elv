#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // Left side
                &kp ESC    &kp Q    &kp W    &kp E     &kp R     &kp T
                &kp TAB    &kp A    &kp S    &kp D     &kp F     &kp G
                &kp LSHFT  &kp Z    &kp X    &kp C     &kp V     &kp B
                &kp LCTRL  &kp LGUI &kp LALT &mo 1     &mo 2     &kp SPACE
                // Right side
                &kp Y      &kp U    &kp I    &kp O     &kp P     &kp BSPC
                &kp H      &kp J    &kp K    &kp L     &kp SEMI  &kp SQT
                &kp N      &kp M    &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                &kp RET    &mo 3    &kp LEFT &kp DOWN  &kp UP    &kp RIGHT
            >;
        };

        lower_layer {
            bindings = <
                // Left side
                &kp GRAVE  &kp N1   &kp N2   &kp N3    &kp N4    &kp N5
                &trans    &trans   &trans   &trans    &trans    &trans
                &trans    &trans   &trans   &trans    &trans    &trans
                &trans    &trans   &trans   &trans    &trans    &trans
                // Right side
                &kp N6    &kp N7   &kp N8   &kp N9    &kp N0    &kp DEL
                &trans    &trans   &trans   &trans    &trans    &trans
                &trans    &trans   &trans   &trans    &trans    &trans
                &trans    &trans   &trans   &trans    &trans    &trans
            >;
        };

        raise_layer {
            bindings = <
                // Left side
                &kp F1    &kp F2   &kp F3   &kp F4    &kp F5    &kp F6
                &trans    &trans   &trans   &trans    &trans    &trans
                &trans    &trans   &trans   &trans    &trans    &trans
                &trans    &trans   &trans   &trans    &trans    &trans
                // Right side
                &kp F7    &kp F8   &kp F9   &kp F10   &kp F11   &kp F12
                &trans    &trans   &trans   &trans    &trans    &trans
                &trans    &trans   &trans   &trans    &trans    &trans
                &trans    &trans   &trans   &trans    &trans    &trans
            >;
        };

        adjust_layer {
            bindings = <
                // Left side
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &trans     &trans       &trans       &trans       &trans       &trans
                &trans     &trans       &trans       &trans       &trans       &trans
                &trans     &trans       &trans       &trans       &trans       &trans
                // Right side
                &none      &none        &none        &none        &none        &none
                &none      &none        &none        &none        &none        &none
                &none      &none        &none        &none        &none        &none
                &trans     &trans       &trans       &trans       &trans       &trans
            >;
        };
    };
};